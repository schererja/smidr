[Unit]
Description=Smidr Agent
After=network-online.target
Wants=network-online.target

[Service]
User=ik8ladmin
Group=ik8ladmin
ExecStart=/opt/smidr/bin/smidr-agent --config /etc/smidr/config-agent.yaml
Restart=always
RestartSec=5
LimitNOFILE=65535
WorkingDirectory=/opt/smidr
Environment=SMIDR_ENV=prod

[Install]
WantedBy=multi-user.target
