[Unit]
Description=Smidr Control Plane Server
After=network-online.target
Wants=network-online.target

[Service]
User=smidr
Group=smidr
ExecStart=/opt/smidr/bin/smidr-server -config /etc/smidr/config-server.yaml
Restart=always
RestartSec=5
LimitNOFILE=65535
WorkingDirectory=/opt/smidr
Environment=SMIDR_ENV=prod

[Install]
WantedBy=multi-user.target
