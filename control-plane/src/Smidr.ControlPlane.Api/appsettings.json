{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Grpc": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=smidr.db"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      },
      "Https": {
        "Url": "https://0.0.0.0:5001",
        "Certificate": {
          "Path": "certs/server.pfx",
          "Password": ""
        }
      },
      "Grpc": {
        "Url": "https://0.0.0.0:5002",
        "Protocols": "Http2",
        "Certificate": {
          "Path": "certs/server.pfx",
          "Password": ""
        }
      }
    }
  },
  "AllowedHosts": "*"
}
