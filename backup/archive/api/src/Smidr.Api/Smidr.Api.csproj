<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.66.0" />
    <PackageReference Include="Google.Protobuf" Version="3.33.2" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Generate server stubs from shared proto contracts -->
    <Protobuf Include="../../../proto/smidr/smidr/v1/api.proto" GrpcServices="Server" />
    <Protobuf Include="../../../proto/smidr/smidr/v1/daemon.proto" GrpcServices="Server" />
    <Protobuf Include="../../../proto/smidr/smidr/v1/task.proto" GrpcServices="Server" />
    <Protobuf Include="../../../proto/smidr/smidr/v1/common.proto" GrpcServices="Server" />
  </ItemGroup>

</Project>
